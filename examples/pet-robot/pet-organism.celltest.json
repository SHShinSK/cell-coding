{
  "version": 1,
  "suites": [
    {
      "name": "PresenceSenseCell isolation · 주인 감지 격리",
      "target": "PresenceSenseCell",
      "cases": [
        {
          "name": "weak signal emits DistressSignal",
          "inject": { "type": "OwnerPing", "data": { "rssi": 0.01 } },
          "expect": [
            {
              "kind": "trace",
              "from": "PresenceSenseCell",
              "signal": "DistressSignal",
              "data": { "reason": "lost_signal" }
            },
            { "kind": "none", "signal": "OwnerPresence" }
          ]
        },
        {
          "name": "strong signal emits OwnerPresence close",
          "inject": { "type": "OwnerPing", "data": { "rssi": 0.8 } },
          "expect": [
            {
              "kind": "trace",
              "from": "PresenceSenseCell",
              "signal": "OwnerPresence",
              "data": { "detected": true, "distance": 0.2 }
            },
            { "kind": "none", "signal": "DistressSignal" }
          ]
        },
        {
          "name": "moderate signal emits OwnerPresence far",
          "inject": { "type": "OwnerPing", "data": { "rssi": 0.6 } },
          "expect": [
            {
              "kind": "trace",
              "from": "PresenceSenseCell",
              "signal": "OwnerPresence",
              "data": { "detected": true, "distance": 0.5 }
            }
          ]
        }
      ]
    },
    {
      "name": "MoodDecideCell branches · mood 분기",
      "target": "MoodDecideCell",
      "cases": [
        {
          "name": "positive valence comfort intent",
          "inject": { "type": "AffectState", "data": { "valence": 0.8, "arousal": 0.3 } },
          "expect": [
            {
              "kind": "trace",
              "from": "MoodDecideCell",
              "signal": "SocialIntent",
              "data": { "mode": "comfort" }
            }
          ]
        },
        {
          "name": "low valence follow intent",
          "inject": { "type": "AffectState", "data": { "valence": 0.35, "arousal": 0.6 } },
          "expect": [
            {
              "kind": "trace",
              "from": "MoodDecideCell",
              "signal": "SocialIntent",
              "data": { "mode": "follow" }
            }
          ]
        }
      ]
    },
    {
      "name": "PetOrganism comfort path · comfort 경로",
      "target": "PetOrganism",
      "cases": [
        {
          "name": "close owner comfort interaction",
          "inject": { "type": "OwnerPing", "data": { "rssi": 0.8 } },
          "expect": [
            { "kind": "trace", "signal": "SocialIntent", "data": { "mode": "comfort" } },
            { "kind": "trace", "signal": "ComfortAction", "data": { "behavior": "nuzzle" } },
            { "kind": "trace", "signal": "VocalCue", "data": { "phrase": "purr" } },
            { "kind": "none", "signal": "FollowPulse" }
          ]
        }
      ]
    },
    {
      "name": "PetOrganism follow path · follow 경로",
      "target": "PetOrganism",
      "cases": [
        {
          "name": "moderate owner follow locomotion",
          "inject": { "type": "OwnerPing", "data": { "rssi": 0.6 } },
          "expect": [
            { "kind": "trace", "signal": "SocialIntent", "data": { "mode": "follow" } },
            { "kind": "trace", "signal": "FollowPulse", "data": { "pace": 0.5 } },
            { "kind": "none", "signal": "ComfortAction", "from": "ComfortActCell" }
          ]
        }
      ]
    },
    {
      "name": "PetOrganism immune fallback · immune fallback",
      "target": "PetOrganism",
      "immune": true,
      "cases": [
        {
          "name": "distress triggers ComfortAction fallback",
          "inject": { "type": "OwnerPing", "data": { "rssi": 0.01 } },
          "expect": [
            { "kind": "trace", "signal": "DistressSignal", "data": { "reason": "lost_signal" } },
            { "kind": "trace", "from": "immune:SafetyPolicy#fallback", "signal": "ComfortAction" }
          ]
        },
        {
          "name": "healthy ping no immune action",
          "inject": { "type": "OwnerPing", "data": { "rssi": 0.8 } },
          "expect": [
            { "kind": "trace", "signal": "OwnerPresence" },
            { "kind": "none", "from": "immune:", "signal": "ComfortAction" }
          ]
        }
      ]
    }
  ]
}
